---
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Slideshow</title>
  <script src="/register-sw.js" defer></script>
  <link rel="manifest" href="/manifest.json" />
  <style is:global>
    /* is:global ist Pflicht: Slides/Thumbs werden per JS erzeugt und bekommen
       kein Astro-Scope-Attribut — gescopte Selektoren würden sie nie treffen
       (Ursache des 2-Slides-Bugs auf 4K-Displays). */
    *{margin:0;padding:0;box-sizing:border-box}
    html{
      /* Eine Quelle für alle Bottom-UI-Positionen; wird per JS auf 0 gesetzt
         wenn der Filmstreifen deaktiviert ist */
      --strip-h:clamp(96px,10vmin,220px);
    }
    html,body{width:100%;height:100%;overflow:hidden;background:#000;color:#fff;
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
      -webkit-font-smoothing:antialiased;touch-action:none;
      -webkit-user-select:none;user-select:none}

    /* ── Loading ── */
    #loader{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;
      background:#000;z-index:900}
    #loader::after{content:'';width:40px;height:40px;border:3px solid rgba(255,255,255,.15);
      border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* ── Stage ── */
    #stage{position:fixed;inset:0;overflow:hidden;background:#000}

    /* ── Slide mode (translate) ── */
    #track{display:flex;height:100%;transition:transform 750ms cubic-bezier(.22,1,.36,1);
      will-change:transform}
    #track.dragging{transition:none}
    .slide{flex:0 0 100vw;width:100vw;height:100%;position:relative;display:flex;
      align-items:center;justify-content:center}
    .slide img.main{max-width:100%;max-height:100%;object-fit:contain;
      position:relative;z-index:2;opacity:0;transition:opacity .3s}
    .slide img.main.loaded{opacity:1}
    .slide img.lqip{position:absolute;inset:0;width:100%;height:100%;
      object-fit:contain;filter:blur(20px);transform:scale(1.1);z-index:1}

    /* ── Fade mode ──
       Nur aktiver Slide + Nachbarn (.near) bleiben sichtbar/decodiert —
       sonst hält der Pi alle Bilder als GPU-Layer im Speicher */
    #stage.fade #track{display:block;height:100%;transform:none !important;
      transition:none !important;will-change:auto}
    #stage.fade .slide{position:absolute;inset:0;opacity:0;visibility:hidden;
      transition:opacity 800ms ease,visibility 0s 800ms;pointer-events:none}
    #stage.fade .slide.near{visibility:visible;transition:opacity 800ms ease}
    #stage.fade .slide.active{opacity:1;visibility:visible;pointer-events:auto;
      transition:opacity 800ms ease}

    /* ── Navigation arrows ──
       vmin-Einheiten: gleiche physische Größe auf beiden Pis
       (D8D8 rendert mit 1920er-Viewport, RPI020 mit 3840).
       43" FHD: 1px ≈ 0,5mm → Ziel ≥40px = 20mm Touchfläche (WCAG/Kiosk-Praxis) */
    .nav-btn{position:fixed;top:50%;transform:translateY(-50%);z-index:50;
      width:clamp(72px,8vmin,180px);height:clamp(120px,16vmin,360px);border:none;cursor:pointer;
      background:rgba(0,0,0,.4);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
      border-radius:clamp(8px,1vmin,20px);display:flex;align-items:center;justify-content:center;
      opacity:0;transition:opacity .4s,background .2s}
    .nav-btn:hover{background:rgba(0,0,0,.55)}
    .nav-btn:active{background:rgba(255,255,255,.25)}
    .nav-btn svg{width:clamp(36px,4vmin,90px);height:clamp(36px,4vmin,90px);
      stroke:#fff;stroke-width:2.5;fill:none;
      stroke-linecap:round;stroke-linejoin:round}
    #btn-prev{left:clamp(12px,1.5vmin,32px)}
    #btn-next{right:clamp(12px,1.5vmin,32px)}

    /* ── Thumbnail strip ── */
    #thumbstrip{position:fixed;bottom:0;left:0;right:0;z-index:55;
      height:var(--strip-h);padding:clamp(10px,1vmin,24px) 0;
      background:linear-gradient(transparent,rgba(0,0,0,.7));
      display:flex;align-items:center;
      overflow-x:auto;overflow-y:hidden;
      scroll-behavior:smooth;-webkit-overflow-scrolling:touch;
      scrollbar-width:none;gap:clamp(8px,.8vmin,18px);
      opacity:0;transition:opacity .4s;touch-action:pan-x}
    #thumbstrip::-webkit-scrollbar{display:none}
    #thumbstrip::before,#thumbstrip::after{content:'';flex:0 0 16px}
    .thumb{flex:0 0 auto;width:clamp(72px,7.5vmin,170px);height:clamp(72px,7.5vmin,170px);
      border-radius:6px;overflow:hidden;
      cursor:pointer;border:2px solid transparent;opacity:.5;
      transition:opacity .25s,border-color .25s,transform .25s;position:relative}
    .thumb img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}
    .thumb:active{transform:scale(.92)}
    .thumb.on{opacity:1;border-color:rgba(255,255,255,.85);transform:scale(1.08)}

    /* ── Counter — immer sichtbar (Orientierung), bei Interaktion voll ── */
    #counter{position:fixed;bottom:calc(var(--strip-h) + clamp(8px,1vmin,20px));
      right:clamp(16px,2vmin,44px);z-index:56;
      font-size:clamp(18px,2.2vmin,52px);font-variant-numeric:tabular-nums;
      letter-spacing:.08em;color:rgba(255,255,255,.85);
      background:rgba(0,0,0,.45);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
      padding:clamp(4px,.5vmin,12px) clamp(10px,1.2vmin,28px);border-radius:6px;
      opacity:.6;transition:opacity .4s}

    /* ── Progress bar ── */
    #progress{position:fixed;bottom:var(--strip-h);left:0;width:100%;height:clamp(3px,.3vmin,7px);z-index:60;
      background:rgba(255,255,255,.1)}
    #progress-fill{height:100%;background:rgba(255,255,255,.45);
      transform-origin:left;transform:scaleX(0);transition:none}
    #progress-fill.animate{transition:transform var(--interval) linear}

    /* ── Caption ── */
    #caption{position:fixed;bottom:calc(var(--strip-h) + clamp(12px,1.2vmin,28px));left:20px;z-index:50;
      background:rgba(0,0,0,.45);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
      padding:10px 18px;border-radius:6px;opacity:0;transition:opacity .4s;
      max-width:50vw}
    #cap-title{font-weight:600;font-size:clamp(15px,1.8vmin,40px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    #cap-sub{font-size:clamp(12px,1.4vmin,32px);opacity:.65;margin-top:2px}

    /* ── UI visibility ── */
    .chrome-visible .nav-btn,
    .chrome-visible #caption,
    .chrome-visible #thumbstrip{opacity:1}
    .chrome-visible #counter{opacity:1}
  </style>
</head>
<body>
  <div id="loader"></div>

  <div id="stage">
    <div id="track"></div>
  </div>

  <button class="nav-btn" id="btn-prev" aria-label="Zurück">
    <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button class="nav-btn" id="btn-next" aria-label="Weiter">
    <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
  </button>

  <div id="counter"></div>

  <div id="caption">
    <div id="cap-title"></div>
    <div id="cap-sub"></div>
  </div>

  <div id="thumbstrip"></div>

  <div id="progress"><div id="progress-fill"></div></div>

  <script>
  (async () => {
    /* ── Sanity config ── */
    const PROJECT = '832k5je1';
    const DATASET = 'production';

    /* Bildbreite passend zum Display anfordern statt fix 1920:
       4K-Pi bekommt 2560 (mehr bringt auf dem Pi nichts, kostet nur Decode-Zeit),
       FHD-Pi 1920. Feste Stufen → Service-Worker-Cache trifft. */
    const px = Math.round(window.screen.width * (window.devicePixelRatio || 1));
    const MAIN_W  = px > 2200 ? 2560 : (px > 1500 ? 1920 : 1280);
    const THUMB_W = px > 2200 ? 360 : 240;

    function imgUrl(ref, w) {
      const r = ref?.asset?._ref || ref?.asset?._id;
      if (!r) return '';
      const p = r.split('-');
      const fmt = p[p.length - 1];
      const dims = p[p.length - 2];
      const id = p.slice(1, -2).join('-');
      return `https://cdn.sanity.io/images/${PROJECT}/${DATASET}/${id}-${dims}.${fmt}?w=${w}&fit=max&auto=format&q=80`;
    }

    function lqipSrc(ref) {
      return ref?.asset?.metadata?.lqip || '';
    }

    /* ── Load data ── */
    let data = null;
    try {
      const r = await fetch('/kiosk-content.json', { cache: 'no-store' });
      if (r.ok) { const j = await r.json(); if (j?.kioskId) data = j; }
    } catch (_) {}

    if (!data) {
      const id = new URLSearchParams(location.search).get('id');
      if (!id) { document.getElementById('loader').textContent = 'Kein Kiosk-ID'; return; }
      const q = `*[_type=="kioskDevice" && (kioskId==$id || hostname==$id || _id==$id)][0]{
        "slides": select(
          ausstellung->kioskTemplate.slideshowSettings.bildquelle == "galerie" => ausstellung->galerie[]{
            "_id":_key,"titel":coalesce(caption,alt),
            "hauptbild":{"asset":asset->{_id,metadata{lqip,dimensions}}}},
          ausstellung->kioskTemplate.slideshowSettings.bildquelle == "exponate" => ausstellung->exponate[]->{
            _id,titel,untertitel,inventarnummer,
            hauptbild{...,asset->{_id,_ref,metadata{lqip,dimensions}}}},
          coalesce(
            ausstellung->exponate[]->{_id,titel,untertitel,inventarnummer,
              hauptbild{...,asset->{_id,_ref,metadata{lqip,dimensions}}}},
            ausstellung->galerie[]{"_id":_key,"titel":coalesce(caption,alt),
              "hauptbild":{"asset":asset->{_id,metadata{lqip,dimensions}}}}
          )
        ),
        "slideshowSettings": ausstellung->kioskTemplate.slideshowSettings
      }`;
      const url = `https://${PROJECT}.api.sanity.io/v2024-01-01/data/query/${DATASET}?query=${encodeURIComponent(q)}&$id=${encodeURIComponent(JSON.stringify(id))}`;
      const res = await fetch(url);
      data = (await res.json()).result;
    }

    if (!data) { document.getElementById('loader').textContent = 'Keine Daten'; return; }

    const settings = data.slideshowSettings || {};
    /* "slides" ist die neue dedizierte Liste; "exponate" als Fallback solange
       auf den Pis noch ein altes kiosk-content.json liegt */
    const items = (data.slides || data.exponate || []).filter(e => e.hauptbild);
    const N = items.length;
    if (N === 0) { document.getElementById('loader').textContent = 'Keine Bilder'; return; }

    const INTERVAL = Math.max(4, settings.interval || 8) * 1000;
    const FADE = settings.uebergang === 'fade';
    /* "!== false": Felder fehlen bei älteren Dokumenten → Default ist AN */
    const SHOW_INFO   = settings.zeige_info !== false;
    const SHOW_THUMBS = settings.zeige_thumbnails !== false;
    const SHOW_COUNT  = settings.zeige_counter !== false;
    const RESUME_DELAY = 45000;
    const CHROME_HIDE = 4000;

    /* ── DOM refs ── */
    const stage      = document.getElementById('stage');
    const track      = document.getElementById('track');
    const prevBtn    = document.getElementById('btn-prev');
    const nextBtn    = document.getElementById('btn-next');
    const counter    = document.getElementById('counter');
    const caption    = document.getElementById('caption');
    const capTitle   = document.getElementById('cap-title');
    const capSub     = document.getElementById('cap-sub');
    const progFill   = document.getElementById('progress-fill');
    const thumbstrip = document.getElementById('thumbstrip');

    if (FADE) stage.classList.add('fade');
    if (!SHOW_INFO) caption.style.display = 'none';
    if (!SHOW_COUNT) counter.style.display = 'none';
    if (!SHOW_THUMBS) {
      thumbstrip.style.display = 'none';
      document.documentElement.style.setProperty('--strip-h', '0px');
    }

    progFill.style.setProperty('--interval', INTERVAL + 'ms');

    /* ── Build slides + thumbnails ── */
    const thumbEls = [];
    items.forEach((item, i) => {
      // Slide
      const div = document.createElement('div');
      div.className = 'slide';
      const lq = lqipSrc(item.hauptbild);
      if (lq) {
        const lqEl = document.createElement('img');
        lqEl.className = 'lqip'; lqEl.src = lq; lqEl.alt = '';
        lqEl.setAttribute('aria-hidden', 'true');
        div.appendChild(lqEl);
      }
      const img = document.createElement('img');
      img.className = 'main'; img.alt = item.titel || '';
      img.decoding = 'async';
      img.dataset.src = imgUrl(item.hauptbild, MAIN_W);
      div.appendChild(img);
      track.appendChild(div);

      // Thumbnail
      if (SHOW_THUMBS) {
        const th = document.createElement('div');
        th.className = 'thumb';
        const thImg = document.createElement('img');
        thImg.src = imgUrl(item.hauptbild, THUMB_W) || lq;
        thImg.alt = '';
        thImg.loading = 'lazy';
        thImg.decoding = 'async';
        th.appendChild(thImg);
        th.addEventListener('click', () => { pauseAndResume(); goTo(i); showChrome(); });
        thumbstrip.appendChild(th);
        thumbEls.push(th);
      }
    });

    const slides = track.querySelectorAll('.slide');
    document.getElementById('loader').remove();

    /* ── Lazy loader — decode() abwarten, sonst ruckelt der Wechsel auf dem Pi ── */
    function ensureLoaded(center) {
      for (let d = 0; d <= 2; d++) {
        for (const off of (d === 0 ? [0] : [-d, d])) {
          const idx = (center + off + N) % N;
          const img = slides[idx].querySelector('img.main');
          if (img && img.dataset.src && !img.src) {
            img.src = img.dataset.src;
            img.decode().catch(() => {}).then(() => img.classList.add('loaded'));
          }
        }
      }
    }

    /* ── Navigate ── */
    let cur = 0;

    function goTo(idx, skipTransition) {
      cur = ((idx % N) + N) % N;
      if (FADE) {
        slides.forEach((s, i) => {
          s.classList.toggle('active', i === cur);
          // Nachbarn sichtbar halten → flüssige Überblendung, Rest gibt GPU-Speicher frei
          s.classList.toggle('near', i === (cur + 1) % N || i === (cur - 1 + N) % N);
        });
      } else {
        if (skipTransition) track.classList.add('dragging');
        track.style.transform = `translate3d(${-cur * 100}%, 0, 0)`;
        if (skipTransition) requestAnimationFrame(() => requestAnimationFrame(() => track.classList.remove('dragging')));
      }
      ensureLoaded(cur);
      // Highlight thumbnail + scroll into view
      thumbEls.forEach((t, i) => t.classList.toggle('on', i === cur));
      if (thumbEls[cur]) thumbEls[cur].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      counter.textContent = `${cur + 1} / ${N}`;
      if (SHOW_INFO) {
        capTitle.textContent = items[cur].titel || '';
        const sub = items[cur].inventarnummer || items[cur].untertitel || '';
        capSub.textContent = sub;
        capSub.style.display = sub ? '' : 'none';
        caption.style.visibility = (items[cur].titel || sub) ? '' : 'hidden';
      }
      resetProgress();
    }

    /* ── Progress bar ── */
    function resetProgress() {
      progFill.classList.remove('animate');
      progFill.style.transform = 'scaleX(0)';
      void progFill.offsetWidth;          // force reflow
      if (playing) {
        progFill.classList.add('animate');
        progFill.style.transform = 'scaleX(1)';
      }
    }

    /* ── Auto-play ── */
    let playing = true;
    let timer = null;
    let resumeTimer = null;

    function tick() { goTo(cur + 1); }

    function startAuto() {
      playing = true;
      clearInterval(timer);
      timer = setInterval(tick, INTERVAL);
      resetProgress();
    }

    function pauseAuto() {
      playing = false;
      clearInterval(timer); timer = null;
      clearTimeout(resumeTimer);
      progFill.classList.remove('animate');
      progFill.style.transform = `scaleX(0)`;
    }

    function pauseAndResume() {
      pauseAuto();
      resumeTimer = setTimeout(startAuto, RESUME_DELAY);
    }

    /* ── Chrome visibility ── */
    let chromeTimer;
    function showChrome() {
      document.body.classList.add('chrome-visible');
      clearTimeout(chromeTimer);
      chromeTimer = setTimeout(() => document.body.classList.remove('chrome-visible'), CHROME_HIDE);
    }

    /* ── User interaction ── */
    function userPrev() { pauseAndResume(); goTo(cur - 1); showChrome(); }
    function userNext() { pauseAndResume(); goTo(cur + 1); showChrome(); }

    prevBtn.addEventListener('click', userPrev);
    nextBtn.addEventListener('click', userNext);

    document.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') userPrev();
      else if (e.key === 'ArrowRight') userNext();
    });

    /* ── Swipe (pointer events) — works in both slide + fade mode ── */
    let sx = 0, dx = 0, swiping = false;
    const THRESHOLD = 0.12;    // 12% of screen width

    stage.addEventListener('pointerdown', e => {
      sx = e.clientX; dx = 0; swiping = true;
      if (!FADE) {
        track.classList.add('dragging');
      }
      stage.setPointerCapture(e.pointerId);
    });

    stage.addEventListener('pointermove', e => {
      if (!swiping) return;
      dx = e.clientX - sx;
      if (!FADE) {
        track.style.transform = `translate3d(calc(${-cur * 100}% + ${dx}px), 0, 0)`;
      }
    });

    function endSwipe() {
      if (!swiping) return;
      swiping = false;
      if (!FADE) track.classList.remove('dragging');
      const ratio = dx / window.innerWidth;
      if (Math.abs(ratio) > THRESHOLD) {
        if (ratio < 0) userNext(); else userPrev();
      } else {
        if (!FADE) goTo(cur);
        showChrome();
      }
    }

    stage.addEventListener('pointerup', endSwipe);
    stage.addEventListener('pointercancel', endSwipe);

    /* ── Activity → show chrome ── */
    ['mousemove', 'touchstart'].forEach(ev =>
      document.addEventListener(ev, showChrome, { passive: true })
    );

    /* ── Start ── */
    goTo(0, true);
    startAuto();
    showChrome();

  })();
  </script>
</body>
</html>
