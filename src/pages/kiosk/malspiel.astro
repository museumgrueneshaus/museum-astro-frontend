<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <title>Malspiel</title>
  <style is:global>
    *, *::before, *::after {
      margin: 0; padding: 0; box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
      background: #f0ebe0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      user-select: none;
      -webkit-user-select: none;
    }

    /* ─── App shell ─────────────────────────────────────────────── */
    #app {
      display: flex;
      flex-direction: column;
      width: 100vw;
      height: 100vh;
    }

    /* ─── Top bar ────────────────────────────────────────────────── */
    #top-bar {
      display: flex;
      align-items: center;
      padding: 0 20px;
      height: 64px;
      background: #fff;
      border-bottom: 1px solid #ddd;
      flex-shrink: 0;
      gap: 12px;
      touch-action: manipulation;
    }

    #titel-label {
      font-size: 17px;
      font-weight: 700;
      color: #1a1a1a;
      letter-spacing: -0.02em;
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .action-btn {
      height: 48px;
      padding: 0 20px;
      border: none;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      touch-action: manipulation;
    }

    .action-btn:active { opacity: 0.65; }

    #btn-reset  { background: #efefef; color: #444; }
    #btn-send   { background: #1a1a1a; color: #fff; }

    /* ─── Canvas area ────────────────────────────────────────────── */
    #canvas-area {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e4dfd3;
      overflow: hidden;
      position: relative;
    }

    #canvas-wrapper {
      position: relative;
      box-shadow: 0 4px 32px rgba(0,0,0,0.22), 0 1px 6px rgba(0,0,0,0.1);
    }

    /* Paint layer: white fill, interactive */
    #canvas-paint {
      display: block;
      touch-action: none;   /* ← only here, prevents scroll during draw */
      cursor: crosshair;
    }

    /* Template always on top, never touched */
    #template-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      display: block;
    }

    /* ─── Palette bar ────────────────────────────────────────────── */
    #palette-bar {
      background: #fff;
      border-top: 1px solid #ddd;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      padding: 12px 16px;
      gap: 12px;
      touch-action: manipulation;
    }

    /* 2-row color grid — all colors always visible, no scroll */
    #color-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-content: center;
      flex: 1;
    }

    .color-swatch {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      flex-shrink: 0;
      cursor: pointer;
      border: 3px solid transparent;
      outline: 3px solid transparent;
      outline-offset: 3px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
      transition: transform 0.08s, outline-color 0.08s;
      touch-action: manipulation;
      /* ensure tap fires without delay */
      -webkit-tap-highlight-color: transparent;
    }

    .color-swatch:active  { transform: scale(0.88); }
    .color-swatch.active  {
      outline-color: #1a1a1a;
      transform: scale(1.18);
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    }

    /* Vertical separator */
    .sep {
      width: 1px;
      align-self: stretch;
      background: #ddd;
      flex-shrink: 0;
      margin: 4px 4px;
    }

    /* Tool group */
    #tool-group {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .tool-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 60px;
      height: 72px;
      border: 2.5px solid transparent;
      border-radius: 14px;
      background: transparent;
      cursor: pointer;
      touch-action: manipulation;
      padding: 0;
      transition: background 0.08s, border-color 0.08s;
    }

    .tool-btn:active  { background: #f0f0f0; }
    .tool-btn.active  { background: #f5f5f0; border-color: #1a1a1a; }

    .dot {
      background: #1a1a1a;
      border-radius: 50%;
      display: block;
      flex-shrink: 0;
    }

    .tool-lbl {
      font-size: 10px;
      color: #999;
      font-weight: 500;
      letter-spacing: 0.04em;
    }

    .tool-btn.active .tool-lbl { color: #1a1a1a; }

    /* ─── Overlay ─────────────────────────────────────────────────── */
    #overlay {
      position: fixed; inset: 0;
      background: #f0ebe0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 18px;
      z-index: 100;
    }

    #overlay.gone { display: none; }

    .spinner {
      width: 44px; height: 44px;
      border: 4px solid rgba(0,0,0,0.1);
      border-top-color: #1a1a1a;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* ─── Print ───────────────────────────────────────────────────── */
    #print-img { display: none; }

    @media print {
      #top-bar, #palette-bar, #overlay { display: none !important; }
      #canvas-area {
        width: 100vw; height: 100vh; background: #fff;
        display: flex; align-items: center; justify-content: center;
      }
      #print-img { display: block !important; max-width: 100%; max-height: 100%; }
      #canvas-wrapper { display: none; }
    }
  </style>
</head>
<body>

<div id="overlay">
  <div class="spinner"></div>
  <span style="color:#999;font-size:14px">Wird geladen…</span>
</div>

<div id="app">
  <div id="top-bar">
    <span id="titel-label">Malspiel</span>
    <button class="action-btn" id="btn-reset">Neu anfangen</button>
    <button class="action-btn" id="btn-send">An Kassa senden 🖨</button>
  </div>

  <div id="canvas-area">
    <div id="canvas-wrapper">
      <canvas id="canvas-paint"></canvas>
      <img id="template-img" alt="" crossorigin="anonymous" />
    </div>
    <img id="print-img" alt="" />
  </div>

  <div id="palette-bar">
    <div id="color-grid"></div>
    <div class="sep"></div>
    <div id="tool-group"></div>
  </div>
</div>

<script>
// @ts-nocheck
(function () {
  const PROJECT  = '832k5je1';
  const DATASET  = 'production';
  const API_VER  = '2024-01-01';

  const overlay     = document.getElementById('overlay');
  const colorGrid   = document.getElementById('color-grid');
  const toolGroup   = document.getElementById('tool-group');
  const titelLabel  = document.getElementById('titel-label');
  const btnReset    = document.getElementById('btn-reset');
  const btnSend     = document.getElementById('btn-send');
  const canvasArea  = document.getElementById('canvas-area');
  const wrapper     = document.getElementById('canvas-wrapper');
  const cvs         = document.getElementById('canvas-paint');
  const tmpl        = document.getElementById('template-img');
  const ctx         = cvs.getContext('2d');

  let color    = '#e53935';
  let size     = 14;
  let eraser   = false;
  let drawing  = false;
  let lx = 0, ly = 0;
  let activePenBtn = null;

  /* ── Fetch ─────────────────────────────────────────────────────── */
  async function boot() {
    const id = new URLSearchParams(location.search).get('id');
    if (!id) { err('Kein Malspiel ausgewählt.'); return; }

    const q   = encodeURIComponent(`*[_type=="malspiel"&&_id==$id][0]{titel,ausmalbild{asset->{url,metadata{dimensions}}},farben,stifte,radierer_groesse}`);
    const idp = encodeURIComponent(JSON.stringify(id));
    let spiel;
    try {
      const r = await fetch(`https://${PROJECT}.api.sanity.io/v${API_VER}/data/query/${DATASET}?query=${q}&$id=${idp}`);
      spiel = (await r.json())?.result;
    } catch { err('Netzwerkfehler – Verbindung prüfen.'); return; }

    if (!spiel) { err('Malspiel nicht gefunden.'); return; }
    setup(spiel);
  }

  function err(msg) {
    overlay.innerHTML = `<span style="font-size:2.5rem">⚠️</span>
      <span style="color:#888;font-size:15px;text-align:center;max-width:280px;line-height:1.6">${msg}</span>`;
  }

  /* ── Setup ─────────────────────────────────────────────────────── */
  function setup(spiel) {
    titelLabel.textContent = spiel.titel || 'Malspiel';
    buildColors(spiel.farben || []);
    buildTools(spiel.stifte || [], spiel.radierer_groesse || 40);

    const url  = spiel.ausmalbild?.asset?.url;
    const dims = spiel.ausmalbild?.asset?.metadata?.dimensions;

    if (!url) { initCanvas(800, 800); overlay.classList.add('gone'); return; }

    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      initCanvas(dims?.width || img.naturalWidth || 800,
                 dims?.height || img.naturalHeight || 800);
      tmpl.src = url;
      overlay.classList.add('gone');
    };
    img.onerror = () => { initCanvas(800, 800); overlay.classList.add('gone'); };
    img.src = url;
  }

  /* ── Canvas ────────────────────────────────────────────────────── */
  function initCanvas(iw, ih) {
    const aw = canvasArea.clientWidth  - 24;
    const ah = canvasArea.clientHeight - 24;
    const s  = Math.min(aw / iw, ah / ih, 1);
    const w  = Math.round(iw * s);
    const h  = Math.round(ih * s);

    cvs.width  = w; cvs.height  = h;
    cvs.style.width  = w + 'px';
    cvs.style.height = h + 'px';
    wrapper.style.width  = w + 'px';
    wrapper.style.height = h + 'px';

    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, w, h);
  }

  /* ── Colors ────────────────────────────────────────────────────── */
  function buildColors(farben) {
    const defaults = [
      '#e53935','#e91e8c','#9c27b0','#3f51b5',
      '#2196f3','#00bcd4','#4caf50','#8bc34a',
      '#ffeb3b','#ff9800','#ff5722','#795548',
      '#1a1a1a','#ffffff',
    ];
    const all = farben.length
      ? farben.map(f => f.hex || f)
      : defaults;

    colorGrid.innerHTML = '';
    all.forEach((hex, i) => {
      const sw = document.createElement('div');
      sw.className = 'color-swatch' + (i === 0 ? ' active' : '');
      sw.style.background = hex;
      if (/^#fff(fff)?$/i.test(hex.trim())) {
        sw.style.boxShadow = '0 2px 6px rgba(0,0,0,0.18), inset 0 0 0 1.5px #ccc';
      }
      // Both click (mouse) and touchend (touch) for maximum compatibility
      sw.addEventListener('click', () => pick(hex, sw));
      colorGrid.appendChild(sw);
    });

    color = all[0] || '#e53935';
  }

  function pick(hex, el) {
    colorGrid.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
    el.classList.add('active');
    color  = hex;
    eraser = false;
    if (activePenBtn) {
      toolGroup.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
      activePenBtn.classList.add('active');
    }
  }

  /* ── Tools ─────────────────────────────────────────────────────── */
  function buildTools(stifte, eraserSize) {
    const defaults = [
      {bezeichnung:'Fein',   groesse:4,  standard:false},
      {bezeichnung:'Mittel', groesse:14, standard:true},
      {bezeichnung:'Breit',  groesse:36, standard:false},
    ];
    const all = stifte.length ? stifte : defaults;

    toolGroup.innerHTML = '';
    all.forEach(s => {
      const btn = document.createElement('button');
      btn.className = 'tool-btn';
      const ds = Math.min(Math.max(s.groesse * 0.85, 5), 30);
      btn.innerHTML = `<span class="dot" style="width:${ds}px;height:${ds}px"></span>
                       <span class="tool-lbl">${s.bezeichnung}</span>`;
      btn.addEventListener('click', () => {
        size   = s.groesse;
        eraser = false;
        toolGroup.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activePenBtn = btn;
      });
      toolGroup.appendChild(btn);
      if (s.standard) {
        btn.classList.add('active');
        activePenBtn = btn;
        size = s.groesse;
      }
    });

    // Eraser — paints white; template stays on top always
    const eb = document.createElement('button');
    eb.className = 'tool-btn';
    eb.innerHTML = `<svg width="32" height="26" viewBox="0 0 32 26" fill="none">
      <rect x="2" y="6" width="28" height="14" rx="4" stroke="currentColor" stroke-width="2.5"/>
      <line x1="13" y1="6" x2="13" y2="20" stroke="currentColor" stroke-width="2"/>
    </svg>
    <span class="tool-lbl">Radierer</span>`;
    eb.addEventListener('click', () => {
      eraser = true;
      toolGroup.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
      eb.classList.add('active');
      colorGrid.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
    });
    toolGroup.appendChild(eb);
  }

  /* ── Drawing ────────────────────────────────────────────────────── */
  function pos(e) {
    const r  = cvs.getBoundingClientRect();
    const sx = cvs.width  / r.width;
    const sy = cvs.height / r.height;
    // prefer pointer coords, fall back to first touch
    const p  = e.touches ? e.touches[0] : e;
    return { x: (p.clientX - r.left) * sx,
             y: (p.clientY - r.top)  * sy };
  }

  function down(e) {
    e.preventDefault();
    if (e.pointerId != null) cvs.setPointerCapture(e.pointerId);
    drawing = true;
    const {x, y} = pos(e);
    lx = x; ly = y;
    stroke(x, y, x, y);
  }

  function move(e) {
    if (!drawing) return;
    e.preventDefault();
    const {x, y} = pos(e);
    stroke(lx, ly, x, y);
    lx = x; ly = y;
  }

  function up() { drawing = false; }

  function stroke(x1, y1, x2, y2) {
    ctx.globalCompositeOperation = 'source-over';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.strokeStyle = eraser ? '#ffffff' : color;
    ctx.lineWidth   = eraser ? size * 2.5 : size;
    ctx.lineCap     = 'round';
    ctx.lineJoin    = 'round';
    ctx.stroke();
  }

  // Pointer events cover mouse + stylus + touch when touch-action:none is set on the element
  cvs.addEventListener('pointerdown', down,  { passive: false });
  cvs.addEventListener('pointermove', move,  { passive: false });
  cvs.addEventListener('pointerup',   up);
  cvs.addEventListener('pointercancel', up);

  /* ── Reset ──────────────────────────────────────────────────────── */
  btnReset.addEventListener('click', () => {
    if (!confirm('Bild löschen und neu anfangen?')) return;
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, cvs.width, cvs.height);
  });

  /* ── Print ──────────────────────────────────────────────────────── */
  btnSend.addEventListener('click', () => {
    const off = document.createElement('canvas');
    off.width = cvs.width; off.height = cvs.height;
    const oc  = off.getContext('2d');
    oc.drawImage(cvs, 0, 0);
    if (tmpl.complete && tmpl.naturalWidth > 0) {
      oc.drawImage(tmpl, 0, 0, off.width, off.height);
    }
    document.getElementById('print-img').src = off.toDataURL('image/png');
    window.print();
  });

  boot();
})();
</script>
</body>
</html>
