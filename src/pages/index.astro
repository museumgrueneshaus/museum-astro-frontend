---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Museum Grünes Haus" theme="light">

  <!-- Welcome / Scanner screen -->
  <div id="welcome-screen" class="screen">
    <div class="welcome-content">
      <div class="museum-icon">
        <svg width="56" height="56" viewBox="0 0 64 64" fill="none">
          <rect width="64" height="64" fill="#111"/>
          <rect x="8" y="28" width="48" height="28" fill="#fff"/>
          <polygon points="32,6 8,28 56,28" fill="#fff"/>
        </svg>
      </div>
      <h1 class="welcome-title">Museum<br/>Grünes Haus</h1>
      <p class="welcome-sub">Scannen Sie den QR-Code am Exponat oder an der Ausstellung, um mehr zu erfahren.</p>
      <p class="welcome-sub-en">Scan the QR code at any exhibit or exhibition entrance to learn more.</p>
      <button id="scan-btn" class="scan-btn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><rect x="7" y="7" width="3" height="3"/><rect x="14" y="7" width="3" height="3"/><rect x="14" y="14" width="3" height="3"/><rect x="7" y="14" width="3" height="3"/></svg>
        QR-Code scannen
      </button>
    </div>

    <!-- Camera overlay -->
    <div id="scanner-wrap" class="scanner-wrap" hidden>
      <div class="scanner-viewport">
        <video id="scanner-video" playsinline></video>
        <div class="scanner-overlay"><div class="scanner-frame"></div></div>
        <p class="scanner-hint">QR-Code in den Rahmen halten</p>
      </div>
      <button id="scan-cancel" class="scan-cancel">Abbrechen</button>
    </div>
  </div>

  <!-- Single exhibit detail screen -->
  <div id="detail-screen" class="screen" hidden>
    <button id="back-btn" class="back-btn" aria-label="Zurück">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </button>
    <div id="detail-inner"></div>
  </div>

  <!-- Collection / exhibition screen -->
  <div id="collection-screen" class="screen" hidden>
    <div class="collection-header" id="collection-header">
      <button id="coll-back-btn" class="back-btn-inline" aria-label="Zurück">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Zurück
      </button>
      <h1 id="coll-title" class="coll-title"></h1>
      <p id="coll-desc" class="coll-desc"></p>
    </div>
    <div id="coll-grid" class="coll-grid"></div>
    <!-- Inline exhibit overlay within collection -->
    <div id="coll-detail-overlay" class="coll-detail-overlay" hidden>
      <button id="coll-detail-back" class="back-btn" aria-label="Zurück zur Sammlung">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
      </button>
      <div id="coll-detail-inner"></div>
    </div>
  </div>

  <!-- Loading -->
  <div id="loader" class="loader-screen" hidden>
    <div class="spinner"></div>
  </div>

  <style>
    .screen { min-height: 100vh; }
    [hidden] { display: none !important; }

    /* ── Welcome ── */
    .welcome-content {
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center;
      padding: 2.5rem 1.75rem;
      gap: 1.1rem;
      background: var(--bg);
    }
    .museum-icon { margin-bottom: .25rem; }
    .welcome-title {
      font-size: clamp(2rem, 9vw, 3rem) !important;
      font-weight: 900 !important;
      line-height: 1.08; letter-spacing: -.5px;
      color: var(--text);
    }
    .welcome-sub {
      font-size: .95rem !important;
      color: var(--text-dim); line-height: 1.65;
      max-width: 340px; margin: 0;
    }
    .welcome-sub-en {
      font-size: .82rem !important;
      color: var(--muted); line-height: 1.6;
      max-width: 320px; margin: 0; font-style: italic;
    }
    .scan-btn {
      margin-top: .75rem;
      display: inline-flex; align-items: center; gap: .65rem;
      background: #111; color: #fff;
      border: none; padding: 1rem 1.75rem;
      font-size: 1rem !important; font-weight: 700 !important;
      cursor: pointer; letter-spacing: .01em;
      transition: background .2s;
    }
    .scan-btn:active { background: #333; }

    /* ── Scanner ── */
    .scanner-wrap {
      position: fixed; inset: 0; z-index: 50;
      background: #000;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 1.5rem; padding: 1.5rem;
    }
    .scanner-viewport {
      position: relative;
      width: min(400px, 88vw);
      aspect-ratio: 3 / 4;
      background: #000; overflow: hidden;
    }
    #scanner-video { width: 100%; height: 100%; object-fit: cover; }
    .scanner-overlay { position: absolute; inset: 0; pointer-events: none; }
    .scanner-frame {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%,-50%);
      width: 70%; aspect-ratio: 1;
      border: 3px solid #fff; border-radius: 12px;
    }
    .scanner-hint {
      position: absolute; bottom: 1rem; left: 50%;
      transform: translateX(-50%);
      color: rgba(255,255,255,.8);
      font-size: .875rem !important; white-space: nowrap;
    }
    .scan-cancel {
      background: transparent;
      border: 1px solid rgba(255,255,255,.35);
      color: #fff; padding: .75rem 2.5rem;
      font-size: 1rem !important; cursor: pointer;
    }

    /* ── Loader ── */
    .loader-screen {
      position: fixed; inset: 0; z-index: 100;
      background: var(--bg); display: grid; place-items: center;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner {
      width: 40px; height: 40px;
      border: 3px solid var(--border); border-top-color: #111;
      border-radius: 50%; animation: spin .9s linear infinite;
    }

    /* ── Back button (floating) ── */
    .back-btn {
      position: fixed; top: 1rem; left: 1rem; z-index: 20;
      background: rgba(255,255,255,.92); backdrop-filter: blur(8px);
      border: 1px solid var(--border); border-radius: 50%;
      width: 44px; height: 44px;
      display: grid; place-items: center;
      cursor: pointer; color: #111;
      box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }
    .back-btn:active { background: #f0f0f0; }

    /* ── Exhibit detail ── */
    .exhibit-image-wrap {
      width: 100%; aspect-ratio: 4 / 3;
      background: #f0f0f0; overflow: hidden;
    }
    .exhibit-image-wrap img {
      width: 100%; height: 100%;
      object-fit: contain; display: block;
    }
    .exhibit-body { padding: 1.5rem 1.25rem 5rem; }
    .exhibit-category {
      font-size: .72rem !important; font-weight: 700 !important;
      letter-spacing: .08em; text-transform: uppercase;
      color: var(--muted); margin-bottom: .4rem;
    }
    .exhibit-title {
      font-size: clamp(1.55rem, 6vw, 2.2rem) !important;
      font-weight: 900 !important; line-height: 1.1;
      margin-bottom: .4rem;
    }
    .exhibit-subtitle {
      font-size: .95rem !important; font-style: italic;
      color: var(--text-dim); margin-bottom: 1.25rem;
    }
    .exhibit-desc {
      font-size: .975rem !important; line-height: 1.7;
      color: var(--text); margin-bottom: 1.25rem;
    }
    .exhibit-meta {
      border-top: 1px solid var(--border);
      padding-top: 1.1rem; display: grid; gap: .65rem;
    }
    .meta-row {
      display: grid; grid-template-columns: 100px 1fr;
      gap: .4rem; font-size: .875rem !important;
      align-items: start;
    }
    .meta-row strong { font-weight: 600; color: var(--text-dim); }
    .highlight-badge {
      display: inline-block;
      background: #111; color: #fff;
      font-size: .68rem !important; font-weight: 700 !important;
      letter-spacing: .08em; text-transform: uppercase;
      padding: 3px 9px; margin-bottom: .85rem;
    }

    /* ── Collection view ── */
    .collection-header {
      padding: 4rem 1.25rem 1.25rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .back-btn-inline {
      display: inline-flex; align-items: center; gap: .4rem;
      background: transparent; border: none;
      color: var(--muted); font-size: .875rem !important;
      cursor: pointer; padding: 0 0 .75rem;
    }
    .coll-title {
      font-size: clamp(1.4rem, 5.5vw, 2rem) !important;
      font-weight: 900 !important; line-height: 1.1;
      margin-bottom: .4rem;
    }
    .coll-desc {
      font-size: .9rem !important; color: var(--text-dim);
      line-height: 1.6; margin: 0;
    }
    .coll-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1px;
      background: var(--border);
    }
    .coll-card {
      background: var(--bg); cursor: pointer;
      display: flex; flex-direction: column;
    }
    .coll-card-img {
      width: 100%; aspect-ratio: 1;
      background: #f0f0f0; overflow: hidden;
    }
    .coll-card-img img {
      width: 100%; height: 100%;
      object-fit: contain; display: block;
    }
    .coll-card-body { padding: .75rem .875rem 1rem; }
    .coll-card-title {
      font-size: .9rem !important; font-weight: 700 !important;
      line-height: 1.2; margin-bottom: .2rem;
    }
    .coll-card-sub {
      font-size: .78rem !important; color: var(--text-dim);
      font-style: italic;
    }

    /* Collection detail overlay (slides in over grid) */
    .coll-detail-overlay {
      position: fixed; inset: 0; z-index: 30;
      background: var(--bg); overflow-y: auto;
    }
  </style>

  <script>
    const SANITY_PROJECT = import.meta.env.PUBLIC_SANITY_PROJECT_ID || '832k5je1';
    const SANITY_DATASET = import.meta.env.PUBLIC_SANITY_DATASET || 'production';

    const welcomeScreen    = document.getElementById('welcome-screen');
    const detailScreen     = document.getElementById('detail-screen');
    const collectionScreen = document.getElementById('collection-screen');
    const detailInner      = document.getElementById('detail-inner');
    const loader           = document.getElementById('loader');
    const backBtn          = document.getElementById('back-btn');
    const collBackBtn      = document.getElementById('coll-back-btn');
    const scanBtn          = document.getElementById('scan-btn');
    const scannerWrap      = document.getElementById('scanner-wrap');
    const scanCancel       = document.getElementById('scan-cancel');
    const scannerVideo     = document.getElementById('scanner-video') as HTMLVideoElement;
    const collDetailOverlay = document.getElementById('coll-detail-overlay');
    const collDetailInner  = document.getElementById('coll-detail-inner');
    const collDetailBack   = document.getElementById('coll-detail-back');

    function esc(s: any): string {
      if (!s) return '';
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function imageUrl(ref: any, width = 800): string {
      if (!ref) return '';
      const r = ref.asset?._ref;
      if (!r) return '';
      const parts = r.split('-');
      const fmt  = parts[parts.length - 1];
      const dims = parts[parts.length - 2];
      const id   = parts.slice(1, parts.length - 2).join('-');
      return `https://cdn.sanity.io/images/${SANITY_PROJECT}/${SANITY_DATASET}/${id}-${dims}.${fmt}?w=${width}&auto=format`;
    }

    async function sanityFetch(query: string, params: Record<string,any> = {}): Promise<any> {
      let url = `https://${SANITY_PROJECT}.api.sanity.io/v2024-01-01/data/query/${SANITY_DATASET}`
        + `?query=${encodeURIComponent(query)}`;
      for (const [k, v] of Object.entries(params)) {
        url += `&$${k}=${encodeURIComponent(JSON.stringify(v))}`;
      }
      const res  = await fetch(url);
      const data = await res.json();
      return data.result ?? null;
    }

    // ── Exhibit HTML builder (shared) ──
    function buildExhibitHtml(e: any): string {
      const imgSrc  = imageUrl(e.hauptbild, 1200);
      const imgLqip = e.hauptbild?.asset?.metadata?.lqip || '';
      const datierung   = e.datierung   || {};
      const herstellung = e.herstellung || {};
      const physisch    = e.physisch    || {};
      const tags        = e.tags        || [];
      let metaRows = '';
      if (datierung?.jahr_text)   metaRows += `<div class="meta-row"><strong>Datierung</strong><span>${esc(datierung.jahr_text)}</span></div>`;
      if (herstellung?.material)  metaRows += `<div class="meta-row"><strong>Material</strong><span>${esc(herstellung.material)}</span></div>`;
      if (physisch?.masse)        metaRows += `<div class="meta-row"><strong>Maße</strong><span>${esc(physisch.masse)}</span></div>`;
      if (e.organisation)         metaRows += `<div class="meta-row"><strong>Sammlung</strong><span>${esc(e.organisation)}</span></div>`;
      if (e.inventarnummer)       metaRows += `<div class="meta-row"><strong>Inv.-Nr.</strong><span>${esc(e.inventarnummer)}</span></div>`;
      if (tags.length)            metaRows += `<div class="meta-row"><strong>Stichworte</strong><span>${esc(tags.join(', '))}</span></div>`;

      return `
        ${imgSrc ? `
        <div class="exhibit-image-wrap"${imgLqip ? ` style="background:url(${esc(imgLqip)}) center/cover"` : ''}>
          <img src="${esc(imgSrc)}" alt="${esc(e.titel || '')}" loading="eager" decoding="async" />
        </div>` : ''}
        <div class="exhibit-body">
          ${e.ist_highlight ? '<div class="highlight-badge">Highlight</div>' : ''}
          ${e.kategorie?.titel ? `<div class="exhibit-category">${esc(e.kategorie.titel)}</div>` : ''}
          <h1 class="exhibit-title">${esc(e.titel || '')}</h1>
          ${e.untertitel ? `<p class="exhibit-subtitle">${esc(e.untertitel)}</p>` : ''}
          ${e.kurzbeschreibung ? `<p class="exhibit-desc">${esc(e.kurzbeschreibung)}</p>` : ''}
          ${e.beschreibung ? `<p class="exhibit-desc">${esc(e.beschreibung)}</p>` : ''}
          ${metaRows ? `<div class="exhibit-meta">${metaRows}</div>` : ''}
        </div>`;
    }

    // ── Show single exhibit ──
    async function showExhibit(id: string, pushState = true) {
      loader.hidden = false;
      try {
        const e = await sanityFetch(
          `*[_type=="exponat" && (_id==$id || inventarnummer==$id)][0]{
            _id, titel, untertitel, inventarnummer, ist_highlight,
            kurzbeschreibung, beschreibung,
            datierung, herstellung, physisch, organisation, tags,
            hauptbild{..., asset->{_id, _ref, metadata{lqip}}},
            "kategorie": kategorie->{_id, titel}
          }`,
          { id }
        );
        if (!e) { loader.hidden = true; alert('Exponat nicht gefunden.'); return; }
        detailInner.innerHTML = buildExhibitHtml(e);
        welcomeScreen.hidden    = true;
        collectionScreen.hidden = true;
        detailScreen.hidden     = false;
        loader.hidden           = true;
        window.scrollTo(0, 0);
        if (pushState) history.pushState({ type: 'exhibit', id }, '', `?id=${encodeURIComponent(id)}`);
      } catch (err) {
        loader.hidden = true;
        console.error(err);
        alert('Fehler beim Laden des Exponats.');
      }
    }

    // ── Show collection / exhibition ──
    async function showCollection(id: string, pushState = true) {
      loader.hidden = false;
      try {
        // id can be an Ausstellung _id or a Kategorie _id — try both
        const ausstellung = await sanityFetch(
          `*[_type in ["ausstellung","kategorie"] && _id==$id][0]{
            _id, _type, titel, untertitel, beschreibung,
            "exponate": select(
              _type == "ausstellung" => exponate[]->{
                _id, titel, untertitel, inventarnummer, ist_highlight,
                hauptbild{..., asset->{_id, _ref, metadata{lqip}}}
              },
              _type == "kategorie" => *[_type=="exponat" && kategorie._ref == ^._id]{
                _id, titel, untertitel, inventarnummer, ist_highlight,
                hauptbild{..., asset->{_id, _ref, metadata{lqip}}}
              }
            )
          }`,
          { id }
        );
        if (!ausstellung) { loader.hidden = true; alert('Sammlung nicht gefunden.'); return; }

        const collTitle = document.getElementById('coll-title');
        const collDesc  = document.getElementById('coll-desc');
        const collGrid  = document.getElementById('coll-grid');

        collTitle.textContent = ausstellung.titel || '';
        collDesc.textContent  = ausstellung.beschreibung || ausstellung.untertitel || '';

        const exponate = ausstellung.exponate || [];
        collGrid.innerHTML = exponate.map((e: any) => {
          const img = imageUrl(e.hauptbild, 400);
          const lqip = e.hauptbild?.asset?.metadata?.lqip || '';
          return `<div class="coll-card touchable" data-id="${esc(e._id)}">
            <div class="coll-card-img"${lqip ? ` style="background:url(${esc(lqip)}) center/cover"` : ''}>
              ${img ? `<img src="${esc(img)}" alt="${esc(e.titel || '')}" loading="lazy" />` : ''}
            </div>
            <div class="coll-card-body">
              <div class="coll-card-title">${esc(e.titel || '')}</div>
              ${e.untertitel ? `<div class="coll-card-sub">${esc(e.untertitel)}</div>` : ''}
            </div>
          </div>`;
        }).join('');

        // Card click → show exhibit overlay within collection
        collGrid.querySelectorAll('.coll-card').forEach((card: any) => {
          card.addEventListener('click', async () => {
            const eid = card.dataset.id;
            if (!eid) return;
            loader.hidden = false;
            try {
              const e = await sanityFetch(
                `*[_type=="exponat" && _id==$id][0]{
                  _id, titel, untertitel, inventarnummer, ist_highlight,
                  kurzbeschreibung, beschreibung,
                  datierung, herstellung, physisch, organisation, tags,
                  hauptbild{..., asset->{_id, _ref, metadata{lqip}}},
                  "kategorie": kategorie->{_id, titel}
                }`,
                { id: eid }
              );
              if (!e) { loader.hidden = true; return; }
              collDetailInner.innerHTML = buildExhibitHtml(e);
              collDetailOverlay.hidden = false;
              loader.hidden = true;
              collDetailOverlay.scrollTo(0, 0);
            } catch { loader.hidden = true; }
          });
        });

        welcomeScreen.hidden    = true;
        detailScreen.hidden     = true;
        collectionScreen.hidden = false;
        collDetailOverlay.hidden = true;
        loader.hidden            = true;
        window.scrollTo(0, 0);
        if (pushState) history.pushState({ type: 'collection', id }, '', `?ausstellung=${encodeURIComponent(id)}`);
      } catch (err) {
        loader.hidden = true;
        console.error(err);
        alert('Fehler beim Laden der Sammlung.');
      }
    }

    // ── Navigation ──
    backBtn.addEventListener('click', () => {
      detailScreen.hidden  = true;
      welcomeScreen.hidden = false;
      history.pushState({}, '', '/');
    });
    collBackBtn.addEventListener('click', () => {
      collectionScreen.hidden = true;
      welcomeScreen.hidden    = false;
      history.pushState({}, '', '/');
    });
    collDetailBack.addEventListener('click', () => {
      collDetailOverlay.hidden = true;
    });

    window.addEventListener('popstate', () => {
      const p = new URLSearchParams(location.search);
      const id    = p.get('id');
      const coll  = p.get('ausstellung');
      if (id)   showExhibit(id, false);
      else if (coll) showCollection(coll, false);
      else {
        detailScreen.hidden     = true;
        collectionScreen.hidden = true;
        welcomeScreen.hidden    = false;
      }
    });

    // ── QR Scanner ──
    let qrScanner: any = null;

    async function handleQrResult(text: string) {
      if (!text) return;
      stopScanner();
      try {
        const u = new URL(text);
        const id   = u.searchParams.get('id');
        const coll = u.searchParams.get('ausstellung');
        if (id)   { await showExhibit(id); return; }
        if (coll) { await showCollection(coll); return; }
        // /exponat/{id} URL pattern
        const m = u.pathname.match(/\/exponat\/([^/]+)/);
        if (m)   { await showExhibit(m[1]); return; }
        // Otherwise navigate to full URL (e.g. external link in QR)
        window.location.href = u.href;
      } catch {
        // Raw ID (not a URL)
        await showExhibit(text);
      }
    }

    async function startScanner() {
      scannerWrap.hidden = false;
      try {
        const { default: QrScanner } = await import('qr-scanner');
        if (!qrScanner) {
          qrScanner = new QrScanner(
            scannerVideo,
            (result: any) => handleQrResult(result?.data || String(result || '')),
            { preferredCamera: 'environment', highlightScanRegion: true }
          );
        }
        await qrScanner.start();
      } catch (err) {
        console.warn('QrScanner nicht verfügbar:', err);
        scannerWrap.hidden = true;
        alert('Kamera-Zugriff nicht möglich.');
      }
    }

    function stopScanner() {
      try { qrScanner?.stop(); } catch {}
      scannerWrap.hidden = true;
    }

    scanBtn.addEventListener('click', startScanner);
    scanCancel.addEventListener('click', stopScanner);

    // ── Init from URL params ──
    const initParams = new URLSearchParams(location.search);
    const initId   = initParams.get('id');
    const initColl = initParams.get('ausstellung');
    if (initId)   showExhibit(initId, false);
    else if (initColl) showCollection(initColl, false);
  </script>
</Layout>
